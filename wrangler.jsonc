{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-soubiran-dev",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "BASE_URL": "https://soubiran.dev/meta.en.json"
  },
  "ai_search": [
    {
      "binding": "AI_SEARCH",
      "instance_name": "markdown-soubiran-dev",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.1
    },
    "logs": {
      "enabled": true,
      "persist": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  }
}
