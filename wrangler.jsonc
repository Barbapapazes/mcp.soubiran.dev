{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-soubiran-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "PAGES_BASE_URL": "https://soubiran.dev/pages.json",
    "TALKS_BASE_URL": "https://talks.soubiran.dev/talks.json",
    "INFRA_BASE_URL": "https://infra.soubiran.dev/pages.json"
  },
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "soubiran-dev",
      "remote": true
    }
  ],
  "worker_loaders": [
    {
      "binding": "CONTENT_LOADER"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.1
    },
    "logs": {
      "enabled": true,
      "persist": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  }
}
